* text=auto eol=lf

*.md text eol=lf
*.txt text eol=lf
*.ps1 text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 角色导入资料保持原字节，便于跨平台按来源指纹复核。
yggforge-core/roles/*/projects/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
yggforge-core/roles/*/skills/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

# 二进制素材不按正文生成差异，保留完整原字节。
*.pdf binary
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.mp3 binary
*.wav binary
*.flac binary
*.ogg binary
*.m4a binary
*.aac binary
*.mp4 binary
*.webm binary
*.mov binary
*.pptx binary
*.docx binary
*.xlsx binary
