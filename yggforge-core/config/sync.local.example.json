{
  "gitlab": {
    "api_url": "http://gitlab.example.internal/api/v4",
    "token_env": "YGG_GITLAB_TOKEN"
  },
  "push_safety": {
    "enable_warning": true,
    "protected_branch_patterns": [
      "main",
      "master"
    ],
    "high_access_threshold": 40,
    "on_risky_protected_branch": "ask_user",
    "on_unable_to_check_permissions": "continue"
  }
}
