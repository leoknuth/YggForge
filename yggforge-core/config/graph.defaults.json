{
  "version": 1,
  "default_hop": 2,
  "entry_related_hops": 1,
  "max_tag_nodes": 64,
  "max_path_depth_under_knowledge": 5,
  "weight": {
    "default_edge": 0.70,
    "min_expand": 0.15,
    "epsilon": 1.0e-6,
    "hop_decay": 0.75,
    "undirected_load": true
  },
  "suggest": {
    "min_cooccur": 3,
    "ppmi_tau": 2.0,
    "w_cooccur_min": 0.25,
    "w_cooccur_max": 0.65,
    "apply_floor": 0.55,
    "top_k_per_tag": 10,
    "max_tag_frequency": 0.50,
    "denylist": ["ygg"],
    "laplace_epsilon": 1.0,
    "output": "indexes/tag-suggestions.json"
  },
  "storage": {
    "full_load_max_bytes": 1073741824,
    "shard_max_bytes": 8388608,
    "shard_max_lines": 100000,
    "max_prefix_len": 8
  },
  "paths": {
    "tag_graph": "graph/tag-graph.yaml",
    "tag_synonyms": "graph/tag-synonyms.yaml",
    "catalog_dir": "graph/catalog",
    "tag_inverted_dir": "graph/tag-inverted"
  }
}
