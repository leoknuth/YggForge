{
  "cursor": {
    "enabled": true,
    "profile": "cursor",
    "core_bundle": {
      "name": "yggforge_core",
      "source": ".",
      "targets": {
        "windows": "~/.cursor/yggforge-core",
        "linux": "~/.cursor/yggforge-core",
        "darwin": "~/.cursor/yggforge-core"
      }
    },
    "mappings": [
      {
        "name": "rules",
        "source": "profiles/cursor/rules",
        "project_targets": {
          "windows": "<project>/.cursor/rules",
          "linux": "<project>/.cursor/rules",
          "darwin": "<project>/.cursor/rules"
        }
      },
      {
        "name": "skills",
        "source": "profiles/cursor/skills",
        "targets": {
          "windows": "~/.cursor/skills",
          "linux": "~/.cursor/skills",
          "darwin": "~/.cursor/skills"
        },
        "project_targets": {
          "windows": "<project>/.cursor/skills",
          "linux": "<project>/.cursor/skills",
          "darwin": "<project>/.cursor/skills"
        }
      },
      {
        "name": "hooks",
        "source": "profiles/cursor/hooks",
        "targets": {
          "windows": "~/.cursor/hooks",
          "linux": "~/.cursor/hooks",
          "darwin": "~/.cursor/hooks"
        },
        "project_targets": {
          "windows": "<project>/.cursor/hooks",
          "linux": "<project>/.cursor/hooks",
          "darwin": "<project>/.cursor/hooks"
        }
      },
      {
        "name": "hooks_config",
        "sources": {
          "windows": "profiles/cursor/hooks.windows.json",
          "linux": "profiles/cursor/hooks.json",
          "darwin": "profiles/cursor/hooks.json"
        },
        "targets": {
          "windows": "~/.cursor/hooks.json",
          "linux": "~/.cursor/hooks.json",
          "darwin": "~/.cursor/hooks.json"
        },
        "project_targets": {
          "windows": "<project>/.cursor/hooks.json",
          "linux": "<project>/.cursor/hooks.json",
          "darwin": "<project>/.cursor/hooks.json"
        }
      }
    ]
  },
